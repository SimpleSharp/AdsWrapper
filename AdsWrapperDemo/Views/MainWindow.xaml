<Window x:Class="AdsWrapperDemo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdsWrapperDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TextBlockAds"
                   Grid.Row="3"
                   Grid.Column="1"
                   Text="ADS:"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />

        <TextBox x:Name="TextBoxAds"
                 Grid.Row="3"
                 Grid.Column="3"
                 Text="127.0.0.1.1.1"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center" />

        <TextBlock x:Name="TextBlockActivate"
                   Grid.Row="4"
                   Grid.Column="1"
                   Text="Activate:"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />

        <ToggleButton x:Name="ToggleButtonActivate"
                      Grid.Row="4"
                      Grid.Column="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Checked="ToggleButtonActivateChecked"
                      Unchecked="ToggleButtonActivateUnchecked" />

        <TextBlock x:Name="TextBlockRead"
                   Grid.Row="1"
                   Grid.Column="5"
                   Text="Read Data:"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <ListBox x:Name="ListBoxRead"
                 Grid.Row="3"
                 Grid.RowSpan="5"
                 Grid.Column="5"
                 BorderThickness="1"
                 BorderBrush="Gray"
                 ItemsSource="{Binding ReadPlcData}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch" />

        <TextBlock x:Name="TextBlockWrite"
                   Grid.Row="1"
                   Grid.Column="7"
                   Text="Data to write:"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <ListBox x:Name="ListBoxWrite"
                 Grid.Row="3"
                 Grid.RowSpan="5"
                 Grid.Column="7"
                 BorderThickness="1"
                 BorderBrush="Gray"
                 ItemsSource="{Binding WrittenPlcData}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch" />
        
        <TextBlock x:Name="TextBlockSoftwareState"
            Grid.Row="6"
            Grid.Column="1"
            Text="Software state:"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>

        <TextBlock x:Name="TextBlockHardwareState"
            Grid.Row="7"
            Grid.Column="1"
            Text="Hardware state:"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>
        <TextBox x:Name="TextBoxSoftwareState"
            Grid.Row="6"
            Grid.Column="3"
            IsReadOnly="True"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" />
        <TextBox x:Name="TextBoxHardwareState"
            Grid.Row="7"
            Grid.Column="3"
            IsReadOnly="True"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" />
    </Grid>

</Window>
